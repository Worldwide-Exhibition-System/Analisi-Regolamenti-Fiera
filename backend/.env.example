# Copia questo file come .env (stessa cartella) per provare il servizio in locale.
# Su Render le variabili si inseriscono nel pannello Environment, MAI in un file
# versionato su GitHub. Il file .env è escluso dal repository (.gitignore).

# Chiave API Anthropic del Team WES AI (console.anthropic.com).
ANTHROPIC_API_KEY=

# Codice che i PM inseriscono una volta sola nella pagina. Serve a evitare che
# chiunque trovi l'URL possa consumare il credito API. Vuoto = servizio aperto
# a chiunque (sconsigliato).
CODICE_ACCESSO=

# Segreto con cui il server firma il testo delle pagine e il file di lavoro.
# Almeno 32 caratteri casuali. Si genera per esempio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Se cambia, i file di lavoro già salvati vengono importati con le voci
# confermate riportate a "Da verificare" (vedi README).
FIRMA_SEGRETO=

# Modello e profondità di ragionamento.
MODELLO=claude-sonnet-5-5
EFFORT=medium
EFFORT_CHAT=low

# Origini da cui la pagina può chiamare il servizio, separate da virgola.
# Non serve per la pagina servita dal servizio stesso (stesso indirizzo).
ORIGINI_CONSENTITE=http://localhost:3000,http://127.0.0.1:3000
CONSENTI_ORIGINE_NULL=true

# Limiti di servizio
MAX_MB=25
LIMITE_ORARIO=200
MAX_TOKENS=32000

PORT=3000

# Chiave API Anthropic — si crea su console.anthropic.com (account e fatturazione
# separati da Claude Code). Su Render va inserita fra le Environment Variables,
# MAI in un file versionato su GitHub.
ANTHROPIC_API_KEY=sk-ant-...

# Codice che i commerciali inseriscono una volta sola nel widget. Serve a evitare
# che chiunque trovi l'URL possa consumare il credito API. Lascialo vuoto per
# aprire il servizio a chiunque (sconsigliato).
CODICE_ACCESSO=cambiami

# Origini da cui il widget può chiamare il servizio, separate da virgola.
ORIGINI_CONSENTITE=https://jorghes78.github.io,http://localhost:8080

# Consente anche l'apertura del widget con un doppio click dal disco (Origin: null).
CONSENTI_ORIGINE_NULL=true

# Modello e profondità di ragionamento. Valori utili:
#   claude-sonnet-5    equilibrio consigliato
#   claude-haiku-4-5   più veloce ed economico, meno preciso sui documenti disordinati
#   claude-opus-5      il più accurato, circa il doppio di Sonnet
MODELLO=claude-sonnet-5
EFFORT=medium
PENSIERO=adattivo

# Limiti di servizio
MAX_MB=18
LIMITE_ORARIO=40
